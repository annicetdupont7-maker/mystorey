NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: never prefix this value with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# ─── SasPay : l'encaissement des abonnements ──────────────────────────────────
# Clé secrète du tableau de bord SasPay (section Développeur).
#   sk_test_... = bac à sable, aucun argent réel
#   sk_live_... = production, vrai argent
# Portée recommandée : ENCAISSEMENT (PAYIN) seulement. MYSTOREY n'envoie jamais
# d'argent, et une clé qui sait décaisser peut vider le solde si elle fuite.
SASPAY_SECRET_KEY=

# Secret de signature du webhook, affiché UNE SEULE FOIS à sa création chez SasPay.
# Sans lui, aucun webhook n'est accepté et aucun abonnement ne s'active.
SASPAY_WEBHOOK_SECRET=

# Ouvre le passage en caisse des plans payants. Laisser absent (ou autre chose que
# "true") tant que la clé ci-dessus est une clé de test : une vendeuse ne doit pas
# pouvoir payer dans un compte bac à sable.
SASPAY_PAYMENTS_ENABLED=false

# Pays par défaut de la page de paiement (ISO 2 lettres). BJ = Bénin.
SASPAY_COUNTRY=BJ

# Qui paie les frais SasPay. Tarifs réels au Bénin : MTN 3 % + 2 FCFA,
# Moov et Celtiis 3,25 %.
#   ADD_ON   = la vendeuse paie le prix du plan + les frais (ce que les réseaux
#              béninois imposent) : 2 000 + ~62 FCFA, et vous encaissez 2 000
#   DEDUCTED = la vendeuse paie 2 000 pile et les frais sortent de votre part
SASPAY_FEE_CHARGE_MODE=ADD_ON

# Adresse du webhook à déclarer chez SasPay :
#   https://<votre-domaine>/api/webhooks/saspay

# App URL (redirections de retour et webhooks)
NEXT_PUBLIC_APP_URL=https://mystorey.vercel.app

# ─── Anciens prestataires, plus branchés sur le tableau de bord ───────────────
# Kkiapay : code conservé mais aucun bouton ne l'appelle. Son interrupteur est
# séparé pour que réactiver SasPay n'ouvre jamais Kkiapay par accident.
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_WEBHOOK_SECRET=
KKIAPAY_PAYMENTS_ENABLED=false

# FedaPay (optional; keep disabled until the webhook is configured)
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_MERCHANT_ID=
FEDAPAY_WEBHOOK_SECRET=

# Wave (optional; keep disabled until the webhook is configured)
WAVE_API_KEY=
WAVE_MERCHANT_ID=
WAVE_WEBHOOK_SECRET=

# Email de nouvelle commande envoyé à la vendeuse (Resend).
# Sans ces deux valeurs, aucun email ne part et le checkout fonctionne comme avant.
# ORDER_EMAILS_FROM doit être une adresse d'un domaine vérifié chez Resend.
RESEND_API_KEY=
ORDER_EMAILS_FROM=
