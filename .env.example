NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: never prefix this value with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# Kkiapay Payment Provider (sandbox for now)
KKIAPAY_PUBLIC_KEY=your_kkiapay_public_key_here
KKIAPAY_PRIVATE_KEY=your_kkiapay_private_key_here
KKIAPAY_WEBHOOK_SECRET=your_kkiapay_webhook_secret_here

# Opens the paid-plan checkout. Leave unset (or anything but "true") while the keys
# above are sandbox keys: sellers must not be able to pay into a test account.
# Set to "true" only once the three live Kkiapay keys are in place.
KKIAPAY_PAYMENTS_ENABLED=false

# App URL (for Kkiapay redirects and webhooks)
NEXT_PUBLIC_APP_URL=https://mystorey.vercel.app

# FedaPay (optional; keep disabled until the webhook is configured)
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_MERCHANT_ID=
FEDAPAY_WEBHOOK_SECRET=

# Wave (optional; keep disabled until the webhook is configured)
WAVE_API_KEY=
WAVE_MERCHANT_ID=
WAVE_WEBHOOK_SECRET=
